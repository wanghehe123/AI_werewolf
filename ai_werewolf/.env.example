# AI 狼人杀环境变量配置（示例模板）
# ====================================
# 复制本文件为 .env 并填写你的 API Key。
# .env 文件会被 .gitignore 忽略，不会提交到版本库。

# LLM Provider API Keys
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# MiniMax TTS API Key（可选，用于语音合成）
MINIMAX_API_KEY=your_minimax_api_key_here

# Database URL（可选，覆盖 config/application.yaml）
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_werewolf

# Redis URL（可选，覆盖 config/redis.yaml）
# REDIS_URL=redis://localhost:6379/0
